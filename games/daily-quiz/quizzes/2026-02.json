  "03": {
    "type": "FLIP",
    "data": {
      "question": "在中文互联网早期发展过程中，一家以“搜索”为核心业务起家，其名称取自古代词句中反复探寻之意，并逐渐扩展至信息分发、人工智能等多个领域的公司叫什么？",
      "answer": "百度",
      "answerInRegex": false
    }
  },
  "04": {
    "type": "FLIP",
    "data": {
      "question": "全称为“日本海极地气团辐合带”，指冬季于日本海上空形成、长度约1000公里的云带和降水辐合带，通常是日本海沿岸一带出现大雪的主因，其四字字母的缩写是什么？",
      "answer": "JPCZ",
      "answerInRegex": false,
      "submitter": "记忆°Blank丶"
    }
  },
  "05": {
    "type": "FLIP",
    "data": {
      "question": "20世纪中期诞生于瑞士，强调中性、可读性与高度通用性，最初以拉丁语“瑞士”之名命名，后成为国际排版中的经典字体的无衬线字体是什么？",
      "answer": "^(?:Helvetica|海维提卡|赫尔维蒂卡)$",
      "answerInRegex": true
    }
  },
  "06": {
